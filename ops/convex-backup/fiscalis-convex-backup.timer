[Unit]
Description=Back up Fiscalis Convex production to S3 weekly (Sunday 03:15 UTC)

[Timer]
# After the 01:30 UTC archive audit and the nightly provider sync, so the
# week's last snapshot holds them.
OnCalendar=Sun *-*-* 03:15:00 UTC
RandomizedDelaySec=10min
# A Sunday missed while the host was down is backed up once at the next boot.
Persistent=true

[Install]
WantedBy=timers.target
