<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mya.fiscalis-dev</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/bun</string>
    <string>run</string><string>dev</string>
    <string>--hostname</string><string>localhost</string>
    <string>--port</string><string>3100</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/mya/Developer/Fiscalis/frontend</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/mya/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/mya/.local/state/fiscalis/dev.log</string>
  <key>StandardErrorPath</key><string>/Users/mya/.local/state/fiscalis/dev.error.log</string>
</dict>
</plist>
